msgid "Annotation Sync"
msgstr "标注同步"

msgid "Sync annotations and bookmarks between devices."
msgstr "在多台设备间同步标注与书签。"

msgid "Settings"
msgstr "设置"

msgid "Cloud settings"
msgstr "云端设置"

msgid "Manual Sync"
msgstr "手动同步"

msgid "Sync All"
msgstr "全部同步"

msgid "No changed documents to sync."
msgstr "没有需要同步的已修改文档。"

msgid "Sync All paused.\nDo you want to continue or abort syncing documents?"
msgstr "全部同步已暂停。\n是否继续或放弃同步文档？"

msgid "Syncing document %1 of %2...\n%3"
msgstr "正在同步文档 (%1/%2)...\n%3"

msgid "Sync All cancelled."
msgstr "全部同步已取消。"

msgid "Unable to sync modified documents: %1"
msgstr "无法同步已修改的文档: %1"

msgid "Successfully synced modified documents: %1"
msgstr "成功同步已修改的文档: %1"

msgid "Unable to sync the following document(s):\n%1\n\nWould you like to open the pending documents manager?"
msgstr "无法同步以下文档:\n%1\n\n是否打开待处理文档管理器？"

msgid "Open Manager"
msgstr "打开管理器"

msgid "Close"
msgstr "关闭"

msgid "Show pending/unsynced documents"
msgstr "显示待处理/未同步的文档"

msgid "Show Deleted"
msgstr "显示已删除项目"

msgid "Scan library for unsynced annotations"
msgstr "扫描藏书馆寻找未同步的标注"

msgid "Scanning library for annotations...\nThis may take a while if the library is large."
msgstr "正在扫描藏书馆中的标注...\n藏书量较大时可能需要较长时间。"

msgid "Scan complete: added %1 book(s) with annotations to sync list.\nBackground syncing all files may take some time, during which KOReader performance may be reduced."
msgstr "扫描完成：已将 %1 本包含标注的图书添加到同步列表。\n后台同步所有文件可能需要一段时间，在此期间 KOReader 性能可能会有所降低。"
