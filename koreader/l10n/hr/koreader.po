msgid ""
"Increase line spacing of most text, so that lines keep an even spacing "
"whether or not they include ruby.\n"
"Further small adjustments can be done with 'Line Spacing' in the bottom menu."
msgstr ""
"Povećajte razmak između redaka većine teksta, tako da redovi zadrže "
"ravnomjeran razmak bez obzira na to sadrže li ruby.\n"
"Daljnje manje prilagodbe mogu se izvršiti pomoću „Razmak između redaka” u "
"donjem izborniku."

msgid "Render ruby content inline"
msgstr "Prikaži ruby sadržaj unutar retka"

msgid "Disable handling of <ruby> tags and render them inline."
msgstr "Deaktiviraj rukovanje <ruby> oznakama i iscrtaj ih unutar retka."

