msgid "Page Crop"
msgstr "برش صفحه"

msgctxt "Page crop"
msgid "none"
msgstr "هیچ‌کدام"

msgctxt "Page crop"
msgid "auto"
msgstr "خودکار"

msgctxt "Page crop"
msgid "semi-auto"
msgstr "نیمه خودکار"

msgctxt "Page crop"
msgid "manual"
msgstr "دستی"

msgid ""
"Allows cropping blank page margins in the original document.\n"
"This might be needed on scanned documents, that may have speckles or "
"fingerprints in the margins, to be able to use zoom to fit content width.\n"
"- 'none' does not cut the original document margins.\n"
"- 'auto' finds content area automatically.\n"
"- 'semi-auto\" finds content area automatically, inside some larger area "
"defined manually.\n"
"- 'manual\" uses the area defined manually as-is.\n"
"\n"
"In 'semi-auto' and 'manual' modes, you may need to define areas once on an "
"odd page number, and once on an even page number (these areas will then be "
"used for all odd, or even, page numbers)."
msgstr ""

msgid "Margin"
msgstr "حاشیه"

msgid "Set margins to be applied after page-crop and zoom modes are applied."
msgstr ""
"حاشیه ها را تنظیم کنید تا پس از اعمال حالت های برش صفحه و بزرگنمایی اعمال "
"شوند."

msgid "Auto Straighten"
msgstr "صاف کردن خودکار"

msgid "0°"
msgstr "۰°"

msgid "5°"
msgstr "۵°"

msgid "10°"
msgstr "۱۰°"

msgid "15°"
msgstr "۱۵°"

msgid "25°"
msgstr "۲۵°"

msgid ""
"Attempt to automatically straighten tilted source pages.\n"
"Will rotate up to specified value."
msgstr ""
"تلاش میکند به صورت خودکار صفحات کج شده را صاف کند.\n"
"تا مقدار مشخص شده صفحات خواهد چرخاند."

msgid "Horizontal overlap"
msgstr "همپوشانی افقی"

msgid "Set horizontal zoom overlap (between columns)."
msgstr "همپوشانی بزرگنمایی افقی (بین ستون ها) را تنظیم کنید."

msgid "Vertical overlap"
msgstr "همپوشانی عمودی"

msgid "Set vertical zoom overlap (between lines)."
msgstr "همپوشانی بزرگنمایی عمودی (بین ستون ها) را تنظیم کنید."

msgid "Fit"
msgstr ""

msgid "Set how the page should be resized to fit the screen."
msgstr ""

msgid "Rows"
msgstr "ردیف‌ها"

msgid "Columns"
msgstr "ستون‌ها"

msgid "Set the number of columns or rows into which to split the page."
msgstr "تعداد ستون‌ها یا ردیف‌هایی که صفحه را به آن‌ها تقسیم می‌کنید تنظیم کنید."

msgid "Zoom factor"
msgstr "ضریب بزرگنمایی"

msgid "Zoom to"
msgstr "بزرگنمایی به"

msgid "Direction"
msgstr "جهت"

msgid "Left to Right, Top to Bottom"
msgstr "چپ به راست، بالا به پایین"

msgid "Top to Bottom, Left to Right"
msgstr "بالا به پایین، چپ به راست"

msgid "Left to Right, Bottom to Top"
msgstr "چپ به راست، پایین به بالا"

msgid "Bottom to Top, Left to Right"
msgstr "پایین به بالا، چپ به راست"

msgid "Bottom to Top, Right to Left"
msgstr "پایین به بالا، راست به چپ"

msgid "Right to Left, Bottom to Top"
msgstr "راست به چپ، پایین به بالا"

msgid "Top to Bottom, Right to Left"
msgstr "بالا به پایین، راست به چپ"

msgid "Right to Left, Top to Bottom"
msgstr "راست به چپ، بالا به پایین"

msgid ""
"Set how paging and swiping forward should move the view on the page:\n"
"left to right or reverse, top to bottom or reverse."
msgstr ""

msgid ""
"- 'page' mode shows only one page of the document at a time.\n"
"- 'continuous' mode allows you to scroll the pages like you would in a web "
"browser."
msgstr ""
"- حالت 'صفحه' تنها یک صفحه از سند را در آن واحد نمایش می‌دهد .\n"
"- حالت 'پیوسته' به شما اجازه پیمایش صفحات همچون یک مرورگر اینترنتی را می‌دهد."

msgid "Page Gap"
msgstr "شکاف صفحه"

msgid ""
"In continuous view mode, sets the thickness of the separator between "
"document pages."
msgstr "در نمای پیوسته، ضخامت جدا کننده بین صفحات سند را مشخص کنید."

msgid "Progress Bar"
msgstr "نوار پیشرفت"

