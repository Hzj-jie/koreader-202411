msgid "Links always black"
msgstr "پیوند‌ها همیشه سیاه"

msgid "Links always blue"
msgstr "پیوند‌ها همیشه آبی"

msgid "Links always bold"
msgstr "پیوند‌ها همیشه برجسته"

msgid "Links never bold"
msgstr "پیوندها هرگز برجسته نباشند"

msgid "Links always italic"
msgstr "پیوند‌ها همیشه کج"

msgid "Links never italic"
msgstr "پیوندها هیچگاه کج نباشند"

msgid "Links always underlined"
msgstr "پیوند‌ها همیشه زیرخط داشته باشند"

