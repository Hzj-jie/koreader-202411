msgstr "Colunas"

msgid "Set the number of columns or rows into which to split the page."
msgstr "Definir a quantidade de colunas ou linhas em que dividir a página."

msgid "Zoom factor"
msgstr "Fator de ampliação"

msgid "Zoom to"
msgstr "Ampliar para"

msgid "Direction"
msgstr "Direção"

msgid "Left to Right, Top to Bottom"
msgstr "Da esquerda pra direita, de cima pra baixo"

msgid "Top to Bottom, Left to Right"
msgstr "De cima pra baixo, da esquerda pra direita"

msgid "Left to Right, Bottom to Top"
msgstr "Da esquerda pra direita, de baixo pra cima"

msgid "Bottom to Top, Left to Right"
msgstr "De baixo pra cima, da esquerda pra direita"

