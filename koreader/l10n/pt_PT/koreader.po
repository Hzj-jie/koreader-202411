msgid "Invert default rotation in portrait mode"
msgstr "Inverter rotação padrão no modo retrato"

msgid "Invert default rotation in landscape mode"
msgstr "Inverter rotação padrão no modo paisagem"

msgid "Auto-rotate for best fit"
msgstr "Rotação automática para melhor ajuste"

msgid ""
