msgstr "Gömülü biçemler etkinleştirildi."

msgid "Disabled embedded styles."
msgstr "Devre dışı bırakılmış gömülü biçemler."

msgid "Enabled embedded fonts."
msgstr "Etkinleştirilmiş gömülü yazı tipleri."

