msgid "small"
msgstr "mały"

msgctxt "Line spacing"
msgid "medium"
msgstr "średni"

msgctxt "Line spacing"
msgid "large"
msgstr "duży"

msgid "In reflow mode, sets the spacing between lines."
msgstr "W trybie reflow, ustawia odstępy między wierszami."

#. @translators Text alignment. Options given as icons: left, right, center, justify.
msgid "Alignment"
msgstr "Wyrównanie"

msgctxt "Alignment"
msgid "auto"
msgstr "automatyczne"

msgctxt "Alignment"
msgid "left"
msgstr "do lewej"

msgctxt "Alignment"
msgid "center"
