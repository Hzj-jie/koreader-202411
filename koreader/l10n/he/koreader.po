msgstr "0°"

msgid "5°"
msgstr "5°"

msgid "10°"
msgstr "10°"

msgid "15°"
msgstr "15°"

msgid "25°"
msgstr "25°"

msgid ""
"Attempt to automatically straighten tilted source pages.\n"
"Will rotate up to specified value."
msgstr ""
"נסה ליישר באופן אוטומטי עמודי מקור מוטים.\n"
"יסובב עד לערך שצוין."

