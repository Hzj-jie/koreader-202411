msgid_plural "Speed-up rate interval: %1 seconds"
msgstr[0] "Intervalo da taxa de aceleração: %1 segundo"
msgstr[1] "Intervalo da taxa de aceleração: %1 segundos"

msgid "Time interval"
msgstr "Intervalo de tempo"

msgid ""
"Select a decimal value up to 1 second. This is the period of time within "
"which multiple keystrokes will speed-up rate of travel."
msgstr ""
"Selecione um valor decimal de até 1 segundo. Este é o período de tempo "
"dentro do qual pressionar múltiplas teclas vai acelerar deslocamento."

