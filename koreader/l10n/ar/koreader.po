msgstr "غضّ الطرف عن الهوامش الأفقيّة"

msgid "Ignore horizontal paragraph padding"
msgstr "تجاهل الإزاحة الأفقيّة"

#, fuzzy
msgid "Vertical margins"
msgstr "غضّ الطرف عن الهوامش العموديّة"

