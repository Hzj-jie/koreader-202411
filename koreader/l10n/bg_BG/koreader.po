msgid "About book map"
msgstr "Относно картата на книгата"

msgid "Available gestures"
msgstr "Достъпни жестове"

msgid "Page browser on tap"
msgstr "Преглед на страници с докосване"

msgid "Alternative theme"
msgstr "Алтернативна тема"

