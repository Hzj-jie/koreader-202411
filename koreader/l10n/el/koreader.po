msgstr "Παρατεταμένο πάτημα σε κείμενο"

msgid "Dictionary on single word selection"
msgstr "Ενεργοποίηση λεξικού με την επιλογή μίας λέξης"

msgid "Highlight dialog position: %1"
msgstr "Θέση διαλόγου επισημάνσεων: %1"

