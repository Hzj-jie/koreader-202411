msgstr "Τροποποίηση στυλ του χρήστη στο %1"

msgid "No CSS tweak found in this directory"
msgstr "Δεν βρέθηκε τροποποίηση CSS σε αυτόν τον φάκελο"

msgid "Add your own tweaks in koreader/styletweaks/"
msgstr "Προσθήκη των δικών σου τροποποιήσεων στο koreader/styletweaks/"

msgid "Book-specific tweak (long-press to edit)"
msgstr ""
"Ιδιαίτερη τροποποίηση για το βιβλίο (πατήστε παρατεταμένα για επεξεργασία)"

msgid "Book-specific tweak"
msgstr "Ιδιαίτερη τροποποίηση βιβλίου"

msgid "Style tweaks (%1)"
msgstr "Τροποποιήσεις στυλ (%1)"

msgid "Style tweaks"
msgstr "Τροποποιήσεις στυλ"

