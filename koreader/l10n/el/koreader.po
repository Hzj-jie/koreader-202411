msgstr "Ενεργοποίηση πολυ-σαρώσεων"

msgid "Multiswipes"
msgstr "Πολυ-σαρώσεις"

msgid "Custom multiswipes"
msgstr "Προσαρμοσμένες πολυ-σαρώσεις"

