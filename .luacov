return {
  statsfile = "luacov.stats.out",
  reportfile = "luacov.report.out",

  modules = {
    ["frontend.*"] = "koreader",
    ["plugins.*"] = "koreader",
  },

  include = {
    "^koreader/frontend/",
    "^koreader/plugins/",
  },

  exclude = {
    "^linux/spec/",
    "^koreader/ffi/",
    "^koreader/common/",
    "^koreader/jit/",
    "_spec$",
    "_meta$",
  },

  includeuntestedfiles = {
    "koreader/frontend",
    "koreader/plugins",
  },
}
