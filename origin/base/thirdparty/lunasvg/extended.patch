      * @brief Converts the bitmap pixel data from ARGB32 Premultiplied to RGBA Plain format in place.
      */
     void convertToRGBA();
+    void convert(int r, int g, int b, int a, bool unpremultiply) {
+        if(r == 0 && g == 1 && b == 2 && a == 3 && unpremultiply) {
+            convertToRGBA();
+            return;
+        }
+        if(isNull())
+            return;
+        auto w = width();
+        auto h = height();
+        auto s = stride();
+        auto rowData = data();
+        for(int y = 0; y < h; y++) {
+            auto row = rowData + y * s;
+            for(int x = 0; x < w; x++) {
+                auto pb = row[x * 4 + 0];
+                auto pg = row[x * 4 + 1];
+                auto pr = row[x * 4 + 2];
+                auto pa = row[x * 4 + 3];
+                if(unpremultiply && pa != 0) {
+                    pr = (pr * 255) / pa;
+                    pg = (pg * 255) / pa;
+                    pb = (pb * 255) / pa;
+                }
+                row[x * 4 + r] = pr;
+                row[x * 4 + g] = pg;
+                row[x * 4 + b] = pb;
+                row[x * 4 + a] = pa;
+            }
+        }
+    }
 
